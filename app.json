{
  "expo": {
    "name": "VITimer",
    "description": "A timer app for variable interval reinforcement training.",
    "slug": "variable-interval-reinforcement-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "variableintervalreinforcementtimer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "process",
          "processing",
          "audio",
          "process",
          "processing"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.naveend1.variableintervalreinforcementtimer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.naveend1.variableintervalreinforcementtimer"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/audio/bell-sound.mp3"
          ]
        }
      ],
      [
        "expo-background-task",
        {
          "taskName": "background-virt-task",
          "taskTitle": "Variable Interval Reinforcement Timer",
          "taskDescription": "This task runs in the background to keep the timer active.",
          "taskIcon": "./assets/images/notification-icon.png",
          "taskColor": "#ffffff",
          "taskPriority": "high"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01f0e3f9-55ac-40f9-9c8f-b2982bce0565"
      }
    }
  }
}
